# ============================================================
# Fighting Chance Transitional Restoration — Server Environment
# Copy this file to `.env` inside the `server/` folder and fill
# in real values. NEVER commit the real .env file.
#   cp server/.env.example server/.env
# ============================================================

# --- Server ---
PORT=5001

# Allowed frontend origin (comma-separated list allowed in dev)
# Local Vite dev server default:
CLIENT_ORIGIN=http://localhost:5173

# --- Email provider: "smtp" | "resend" | "sendgrid" ---
# The referral endpoint works with any of the three providers.
# Only configure the section matching the provider you choose.
EMAIL_PROVIDER=smtp

# Where referral submissions are delivered
REFERRAL_EMAIL=fightingchancetransitional@gmail.com

# ------------------------------------------------------------
# Option A — SMTP / Nodemailer (works with Gmail App Password)
# For Gmail: enable 2-Step Verification, then create an App
# Password at https://myaccount.google.com/apppasswords and use
# it as SMTP_PASSWORD (regular Gmail passwords will NOT work).
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=fightingchancetransitional@gmail.com
SMTP_PASSWORD=
SMTP_FROM="Fighting Chance Website <fightingchancetransitional@gmail.com>"

# ------------------------------------------------------------
# Option B — Resend (https://resend.com)
# ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM="Fighting Chance Website <onboarding@resend.dev>"

# ------------------------------------------------------------
# Option C — SendGrid (https://sendgrid.com)
# ------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM="Fighting Chance Website <fightingchancetransitional@gmail.com>"

# ------------------------------------------------------------
# Optional: single-service deployment (server also serves the
# built frontend from client/dist). Leave false when the
# frontend is deployed separately (Netlify, Vercel, etc.).
# ------------------------------------------------------------
SERVE_CLIENT_DIST=false
